# Copy to .env and fill in. APP_SECRET signs the SSO cookie — keep it secret and
# stable (changing it logs everyone out). Generate one with:
#   openssl rand -base64 48
APP_SECRET=

# "Only me": comma-separated Plex account ids and/or emails allowed in remotely.
# Find your id at https://plex.tv/api/v2/user (X-Plex-Token) or the gateway logs.
ALLOWED_PLEX_IDS=
ALLOWED_PLEX_EMAILS=

# SSO cookie scope + this service's public URL
COOKIE_DOMAIN=.example.com
PUBLIC_URL=https://auth.example.com
REDIRECT_SUFFIX=.example.com

# Networks that bypass auth entirely (your LAN / Tailscale / docker bridge).
# This is also your lock-out safety net.
TRUSTED=192.168.1.0/24,100.64.0.0/10,172.16.0.0/12

SESSION_DAYS=30
